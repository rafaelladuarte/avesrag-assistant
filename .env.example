# Copie para .env e preencha. O assistant não lê o .env do builder.

# Chave de API: só os comandos que geram embedding cobram (buscar, avaliar)
OPENAI_API_KEY=

# O MongoDB montado pelo builder. Use a mesma URI do .env do builder
# (ex.: porta 27018 se a 27017 estiver ocupada na sua máquina).
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=avesrag

# Opcionais
EMBEDDING_MODEL=text-embedding-3-large   # o mesmo que o builder usou nos documentos
# BUILDER_DIR=../avesrag-dataset-builder # padrão: a pasta irmã deste repositório
